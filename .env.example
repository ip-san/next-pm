DATABASE_URL=postgres://postgres:postgres@localhost:15432/next_pm
JWT_SECRET=change-me-in-production
SESSION_COOKIE_NAME=next_pm_session
# Origin (scheme + host, no trailing slash) embedded in mailed links such as password resets —
# e.g. https://pm.example.com. Required outside local dev: without it, a request whose Host
# header isn't localhost/127.0.0.1 is refused rather than trusted, since blindly embedding an
# unvalidated Host header in a mailed link is a Host header injection risk.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
LDAP_URL=
# 64-character hex string (32 bytes) — required before any user can start pairing a TOTP
# authenticator app. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
ATTACHMENTS_DIR=./storage/attachments
# Port for the worker process's /healthz endpoint (bun run worker). Defaults to 3001 — override
# if that port is already in use on your machine (e.g. by another local service).
WORKER_HEALTH_PORT=3001
